{
  "info": {
    "name": "Orbit Lab 3",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {"key": "base_url", "value": "http://localhost:8080"},
    {"key": "created_vehicle_id", "value": "1"},
    {"key": "new_email", "value": "student@example.com"}
  ],
  "item": [
    {
      "name": "01 GET published list with filter",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{base_url}}/api/launch-vehicles?payload_min=5000&payload_max=20000"
      }
    },
    {
      "name": "02 POST create draft with image and video",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "const body = pm.response.json();",
              "pm.collectionVariables.set('created_vehicle_id', body.id);"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [],
        "body": {
          "mode": "formdata",
          "formdata": [
            {"key": "name", "value": "Lab3 Test Vehicle", "type": "text"},
            {"key": "image", "type": "file", "src": "resources/defaults/default-launch-vehicle.jpg"},
            {"key": "video", "type": "file", "src": "resources/defaults/default-launch-vehicle.mp4"}
          ]
        },
        "url": "{{base_url}}/api/launch-vehicles"
      }
    },
    {
      "name": "03 GET current user draft",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{base_url}}/api/launch-vehicles/draft"
      }
    },
    {
      "name": "04 PUT publish draft",
      "request": {
        "method": "PUT",
        "header": [{"key": "Content-Type", "value": "application/json"}],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"short_description\": \"Тестовая ракета-носитель из ЛР3\",\n  \"payload_kg\": 12000,\n  \"sea_level_thrust_kn\": 9000\n}"
        },
        "url": "{{base_url}}/api/launch-vehicles/draft"
      }
    },
    {
      "name": "05 GET feed (id and next are optional)",
      "request": {
        "method": "GET",
        "header": [],
        "description": "Один бизнес-метод. Для начала ленты оставьте id и next выключенными. Для перехода к следующей записи включите оба параметра.",
        "url": {
          "raw": "{{base_url}}/api/feed",
          "host": ["{{base_url}}"],
          "path": ["api", "feed"],
          "query": [
            {"key": "id", "value": "{{created_vehicle_id}}", "disabled": true},
            {"key": "next", "value": "true", "disabled": true}
          ]
        }
      }
    },
    {
      "name": "06 POST like",
      "request": {
        "method": "POST",
        "header": [{"key": "Content-Type", "value": "application/json"}],
        "body": {"mode": "raw", "raw": "{\n  \"value\": 1\n}"},
        "url": "{{base_url}}/api/launch-vehicles/{{created_vehicle_id}}/like"
      }
    },
    {
      "name": "07 DELETE own launch vehicle",
      "request": {
        "method": "DELETE",
        "header": [],
        "url": "{{base_url}}/api/launch-vehicles/{{created_vehicle_id}}"
      }
    },
    {
      "name": "08 POST register user",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "exec": [
              "pm.collectionVariables.set('new_email', 'student' + Date.now() + '@example.com');"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [{"key": "Content-Type", "value": "application/json"}],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"New Student\",\n  \"email\": \"{{new_email}}\",\n  \"password\": \"123456\"\n}"
        },
        "url": "{{base_url}}/api/users"
      }
    },
    {
      "name": "09 POST login",
      "request": {
        "method": "POST",
        "header": [{"key": "Content-Type", "value": "application/json"}],
        "body": {"mode": "raw", "raw": "{\n  \"email\": \"igor@example.com\",\n  \"password\": \"igor123\"\n}"},
        "url": "{{base_url}}/api/users/login"
      }
    },
    {
      "name": "10 POST logout",
      "request": {
        "method": "POST",
        "header": [{"key": "Content-Type", "value": "application/json"}],
        "body": {"mode": "raw", "raw": "{}"},
        "url": "{{base_url}}/api/users/logout"
      }
    }
  ]
}
