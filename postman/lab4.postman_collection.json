{
  "info": {
    "name": "OrbitLab LR4",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080"
    },
    {
      "key": "jwt",
      "value": ""
    },
    {
      "key": "vehicleId",
      "value": "1"
    }
  ],
  "item": [
    {
      "name": "01 Login",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/users/login",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "users",
            "login"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"igor@example.com\",\n  \"password\": \"igor123\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "const data = pm.response.json();",
              "if (data.access_token) pm.collectionVariables.set('jwt', data.access_token);"
            ]
          }
        }
      ]
    },
    {
      "name": "02 GET Launch Vehicles Public",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/launch-vehicles?payload_min=0&payload_max=30000",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "launch-vehicles"
          ],
          "query": [
            {
              "key": "payload_min",
              "value": "0"
            },
            {
              "key": "payload_max",
              "value": "30000"
            }
          ]
        }
      }
    },
    {
      "name": "03 GET Feed Public",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/feed",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "feed"
          ]
        }
      }
    },
    {
      "name": "04 PUT Publish Guest 401",
      "request": {
        "method": "PUT",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/launch-vehicles/draft",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "launch-vehicles",
            "draft"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"short_description\": \"Test\",\n  \"payload_kg\": 23000,\n  \"sea_level_thrust_kn\": 10000\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      }
    },
    {
      "name": "05 GET Draft Authorized",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{jwt}}"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/launch-vehicles/draft",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "launch-vehicles",
            "draft"
          ]
        }
      }
    },
    {
      "name": "06 PUT Publish Authorized",
      "request": {
        "method": "PUT",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{jwt}}"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/launch-vehicles/draft",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "launch-vehicles",
            "draft"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"short_description\": \"Proton M — ракета-носитель для вывода полезной нагрузки на орбиту.\",\n  \"payload_kg\": 23000,\n  \"sea_level_thrust_kn\": 10000\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      }
    },
    {
      "name": "07 POST Like Authorized",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{jwt}}"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/launch-vehicles/{{vehicleId}}/like",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "launch-vehicles",
            "{{vehicleId}}",
            "like"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"value\": 1\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      }
    },
    {
      "name": "08 DELETE Own Authorized",
      "request": {
        "method": "DELETE",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{jwt}}"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/launch-vehicles/{{vehicleId}}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "launch-vehicles",
            "{{vehicleId}}"
          ]
        }
      }
    },
    {
      "name": "09 Logout Blacklist",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{jwt}}"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/users/logout",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "users",
            "logout"
          ]
        }
      }
    }
  ]
}